generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IngestStatus {
  ACCEPTED
  DUPLICATE
  REJECTED
}

model EventDefinition {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model IngestRequest {
  id              String       @id @default(cuid())
  idempotencyKey  String?      @unique
  receivedAt      DateTime     @default(now())
  status          IngestStatus
  reason          String?
  eventName       String
  userId          String?
  anonymousId     String?
  timestamp       DateTime
}

// Identity stitching: when an anonymous visitor logs in, their prior
// anonymous_id is aliased to the resolved user_id so historical events count
// toward the same person. One anonymous_id maps to exactly one user_id.
model IdentityAlias {
  anonymousId String   @id
  userId      String
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Funnel {
  id        String   @id @default(cuid())
  name      String
  stepsJson Json
  createdAt DateTime @default(now())
}

model Report {
  id          String   @id @default(cuid())
  periodStart DateTime
  periodEnd   DateTime
  payloadJson Json
  createdAt   DateTime @default(now())
}

